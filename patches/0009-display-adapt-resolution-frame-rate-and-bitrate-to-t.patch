+// refresh rate of the mode the desktop runs in now. SDL video must be initialised.
+bool readDisplayMode(int sdlDisplayIndex, displayauto::DisplayMode& out);
+
+// Stream mode and bitrate for a display, with the saved video settings as the
+// reference. Nothing when the display mode is unusable.
+std::optional<Result> compute(const StreamingPreferences* prefs, const displayauto::DisplayMode& display);
+
+} // namespace displayadapt
+
+// Live view for the settings page: connected displays and what "Adapt to the
+// display" would use now. Updates when displays or the relevant settings change.
+class DisplayAdapt : public QObject
+{
+    Q_OBJECT
+
+    // Only refresh while the settings page is visible (SDL is started per refresh)
+    Q_PROPERTY(bool active MEMBER m_Active WRITE setActive NOTIFY activeChanged)
+
+    // [{id, label, primary, width, height, refresh}]
+    Q_PROPERTY(QVariantList displays MEMBER m_Displays NOTIFY changed)
+
+    Q_PROPERTY(bool valid MEMBER m_Valid NOTIFY changed)
+    Q_PROPERTY(QString targetName MEMBER m_TargetName NOTIFY changed)
+    Q_PROPERTY(QSize displaySize MEMBER m_DisplaySize NOTIFY changed)
+    Q_PROPERTY(int displayRefresh MEMBER m_DisplayRefresh NOTIFY changed)
+    Q_PROPERTY(QSize streamSize MEMBER m_StreamSize NOTIFY changed)
+    Q_PROPERTY(int streamFps MEMBER m_StreamFps NOTIFY changed)
+    Q_PROPERTY(int bitrateKbps MEMBER m_BitrateKbps NOTIFY changed)
+
+public:
+    explicit DisplayAdapt(QObject* parent = nullptr);
+
+    Q_INVOKABLE void refresh();
+
+    void setActive(bool active);
+
+signals:
+    void changed();
+    void activeChanged();
+
+private:
+    void schedule();
+    void watchScreen(QScreen* screen);
+
+    QTimer m_Debounce;
+    bool m_Active = false;
+    QVariantList m_Displays;
+    bool m_Valid = false;
+    QString m_TargetName;
+    QSize m_DisplaySize;
+    int m_DisplayRefresh = 0;
+    QSize m_StreamSize;
+    int m_StreamFps = 0;
+    int m_BitrateKbps = 0;
+};
diff --git a/app/backend/displayautoconfig.cpp b/app/backend/displayautoconfig.cpp
new file mode 100644
index 00000000..b00651a0
--- /dev/null
+++ b/app/backend/displayautoconfig.cpp
@@ -0,0 +1,111 @@
+#include "displayautoconfig.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace displayauto {
+
+int snapFps(double refreshHz, const Limits& limits)
+{
+    static const int kRates[] = { 30, 50, 60, 75, 90, 100, 120, 144, 165, 240 };
+
+    // Panels report 59.94 or 143.98; compare against the rounded value
+    const int rounded = static_cast<int>(std::lround(refreshHz));
+    int best = limits.minFps;
+    for (int rate : kRates) {
+        if (rate <= rounded && rate <= limits.maxFps && rate >= limits.minFps) {
+            best = rate;
+        }
+    }
+
+    // A rate well above the nearest standard one (a 48 Hz power-saving mode)
+    // is used as it is instead of dropping to 30
+    if (rounded > best && rounded - best > 10 && rounded <= limits.maxFps) {
+        best = rounded;
+    }
+    return std::min(best, limits.maxFps);
+}
+
+std::optional<StreamMode> chooseMode(const DisplayMode& display, const Limits& limits)
+{
+    if (display.width <= 0 || display.height <= 0) {
+        return std::nullopt;
+    }
+
+    // Always landscape: turning a tablet must not change the stream's shape (and
+    // restart it); the video is letterboxed in a portrait window
+    int w = std::max(display.width, display.height);
+    int h = std::min(display.width, display.height);
+    if (w > limits.maxWidth || h > limits.maxHeight) {
+        // Fit inside the cap and keep the aspect ratio
+        const double scale = std::min(static_cast<double>(limits.maxWidth) / w,
+                                      static_cast<double>(limits.maxHeight) / h);
+        w = static_cast<int>(w * scale);
+        h = static_cast<int>(h * scale);
+    }
+
+    StreamMode m;
+    m.width = w & ~1;
+    m.height = h & ~1;
+    m.fps = snapFps(display.refreshHz > 0 ? display.refreshHz : 60.0, limits);
+    return m;
+}
+
+int chooseBitrate(const StreamMode& savedMode,
+                  int savedBitrate,
+                  int defaultForSaved,
+                  const StreamMode& newMode,
+                  int defaultForNew)
+{
+    if (savedMode == newMode) {
+        return savedBitrate;
+    }
+
+    // Within 5 % of the default for the saved mode: the user never changed it
+    const bool isDefault = defaultForSaved > 0 &&
+                           std::abs(savedBitrate - defaultForSaved) <= defaultForSaved / 20;
+    if (isDefault) {
+        return defaultForNew;
+    }
+
+    if (defaultForSaved <= 0) {
+        return savedBitrate;
+    }
+    const double ratio = std::clamp(static_cast<double>(defaultForNew) / defaultForSaved, 0.4, 1.0);
+    return std::max(1000, static_cast<int>(std::lround(savedBitrate * ratio)));
+}
+
+AdaptGate::AdaptGate(std::chrono::milliseconds debounce,
+                     std::chrono::milliseconds cooldown,
+                     std::optional<Clock::time_point> lastRestart)
+    : m_Debounce(debounce), m_Cooldown(cooldown), m_LastRestart(lastRestart)
+{
+}
+
+bool AdaptGate::update(const StreamMode& wanted, const StreamMode& active, Clock::time_point now)
+{
+    if (wanted == active) {
+        m_Pending.reset();
+        return false;
+    }
+
+    if (!m_Pending || *m_Pending != wanted) {
+        // A new difference, or the display changed again: restart the debounce
+        m_Pending = wanted;
+        m_PendingSince = now;
+        return false;
+    }
+
+    if (now - m_PendingSince < m_Debounce) {
+        return false;
+    }
+    if (m_LastRestart && now - *m_LastRestart < m_Cooldown) {
+        return false;
+    }
+
+    m_LastRestart = now;
+    m_Pending.reset();
+    return true;
+}
+
+} // namespace displayauto
diff --git a/app/backend/displayautoconfig.h b/app/backend/displayautoconfig.h
new file mode 100644
index 00000000..f979bf6b
--- /dev/null
+++ b/app/backend/displayautoconfig.h
@@ -0,0 +1,79 @@
+#pragma once
+
+#include <chrono>
+#include <optional>
+
+// Picks the stream mode (resolution, frame rate, bitrate) that suits the display
+// the stream is shown on. Pure code: the caller reads the display and the saved
+// preferences and applies the result; nothing here touches SDL or Qt.
+namespace displayauto {
+
+struct DisplayMode {
+    int width = 0;
+    int height = 0;
+    double refreshHz = 0;
+};
+
+struct StreamMode {
+    int width = 0;
+    int height = 0;
+    int fps = 0;
+
+    bool operator==(const StreamMode& o) const
+    {
+        return width == o.width && height == o.height && fps == o.fps;
+    }
+    bool operator!=(const StreamMode& o) const { return !(*this == o); }
+};
+
+struct Limits {
+    int maxWidth = 3840;
+    int maxHeight = 2160;
+    int maxFps = 144;
+    int minFps = 30;
+};
+
+// Resolution and frame rate for a display. Returns nothing when the display
+// mode is unusable (zero size), so the caller keeps its saved values.
+std::optional<StreamMode> chooseMode(const DisplayMode& display, const Limits& limits = Limits());
+
+// Largest standard frame rate not above the refresh rate (59.94 -> 60,
+// 143.98 -> 144, 74.97 -> 75), within the limits.
+int snapFps(double refreshHz, const Limits& limits = Limits());
+
+// Bitrate for a new mode. savedBitrate belongs to savedMode. defaultForSaved and
+// defaultForNew are Moonlight's own default bitrates for the two modes.
+// - same mode: unchanged
+// - saved bitrate is the default of the saved mode (never changed): the default
+//   of the new mode
+// - user-set bitrate: scaled by the ratio of the defaults, limited to 0.4x..1.0x.
+//   A bitrate the user chose is treated as the ceiling of their link: it is
+//   lowered for a smaller display, never raised for a bigger one
+int chooseBitrate(const StreamMode& savedMode,
+                  int savedBitrate,
+                  int defaultForSaved,
+                  const StreamMode& newMode,
+                  int defaultForNew);
+
+// Debounce and cooldown for restarting a running stream when the wanted mode
+// differs from the active one. Feed it the current wanted/active modes about
+// once a second; update() returns true once when a restart is due.
+class AdaptGate {
+public:
+    using Clock = std::chrono::steady_clock;
+
+    AdaptGate(std::chrono::milliseconds debounce,
+              std::chrono::milliseconds cooldown,
+              std::optional<Clock::time_point> lastRestart = std::nullopt);
+
+    bool update(const StreamMode& wanted, const StreamMode& active, Clock::time_point now);
+
+private:
+    std::chrono::milliseconds m_Debounce;
+    std::chrono::milliseconds m_Cooldown;
+    std::optional<Clock::time_point> m_LastRestart;
+    std::optional<StreamMode> m_Pending;
+    Clock::time_point m_PendingSince;
+};
+
+} // namespace displayauto
