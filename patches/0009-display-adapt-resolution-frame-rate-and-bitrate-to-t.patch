+        QCOMPARE(displayauto::snapFps(24.0), 30);     // floor
+        QCOMPARE(displayauto::snapFps(48.01), 48);    // far above 30: kept
+        QCOMPARE(displayauto::snapFps(56.0), 50);     // within 10 of a standard rate
+        QCOMPARE(displayauto::snapFps(98.0), 90);
