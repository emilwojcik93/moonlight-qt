From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: emilwojcik93 <adminit@adar.pl>
Date: Tue, 17 Nov 2026 23:52:09 +0100
Subject: [PATCH 2/7] settings: add client posture mode and
 reconnect-on-posture options

Let the user control the posture feature before it is wired into the stream.

StreamingPreferences gains PostureMode (Auto, Always tablet, Never, Always
handheld, Always desktop; persisted as "clientposture", new values appended so
stored settings keep their meaning) and reconnectOnPosture (default on,
persisted as "reconnectonposture"). The stream settings page gets a combo box
and a checkbox for them. The CLI gets --client-posture auto|tablet|never and
--reconnect-on-posture / --no-reconnect-on-posture, following the existing
CaptureSysKeysMode pattern.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 app/cli/commandlineparser.cpp         | 15 ++++++++++
 app/cli/commandlineparser.h           |  1 +
 app/gui/SettingsView.qml              | 43 +++++++++++++++++++++++++++
 app/settings/streamingpreferences.cpp | 10 +++++++
 app/settings/streamingpreferences.h   | 23 ++++++++++++++
 5 files changed, 92 insertions(+)

diff --git a/app/cli/commandlineparser.cpp b/app/cli/commandlineparser.cpp
index 34686374..aa0f3e91 100644
--- a/app/cli/commandlineparser.cpp
+++ b/app/cli/commandlineparser.cpp
@@ -323,6 +323,11 @@ StreamCommandLineParser::StreamCommandLineParser()
         {"fullscreen", StreamingPreferences::CSK_FULLSCREEN},
         {"always",     StreamingPreferences::CSK_ALWAYS},
     };
+    m_PostureModeMap = {
+        {"auto",   StreamingPreferences::POSTURE_AUTO},
+        {"tablet", StreamingPreferences::POSTURE_ALWAYS_TABLET},
+        {"never",  StreamingPreferences::POSTURE_NEVER},
+    };
     m_SteamControllerGripsMap = {
         {"paddles", StreamingPreferences::SCG_PADDLES},
         {"ds4",     StreamingPreferences::SCG_DS4},
@@ -388,6 +393,8 @@ void StreamCommandLineParser::parse(const QStringList &args, StreamingPreference
     parser.addToggleOption("hdr", "HDR streaming");
     parser.addToggleOption("yuv444", "YUV 4:4:4 sampling, if supported");
     parser.addChoiceOption("capture-system-keys", "capture system key combos", m_CaptureSysKeysModeMap.keys());
+    parser.addChoiceOption("client-posture", "touch tablet posture sent to the host", m_PostureModeMap.keys());
+    parser.addToggleOption("reconnect-on-posture", "resume the stream when a posture change needs a new host display");
     parser.addChoiceOption("video-codec", "video codec", m_VideoCodecMap.keys());
     parser.addChoiceOption("video-decoder", "video decoder", m_VideoDecoderMap.keys());
 
@@ -545,6 +552,14 @@ void StreamCommandLineParser::parse(const QStringList &args, StreamingPreference
         preferences->captureSysKeysMode = mapValue(m_CaptureSysKeysModeMap, parser.getChoiceOptionValue("capture-system-keys"));
     }
 
+    // Resolve --client-posture option
+    if (parser.isSet("client-posture")) {
+        preferences->clientPostureMode = mapValue(m_PostureModeMap, parser.getChoiceOptionValue("client-posture"));
+    }
+
+    // Resolve --reconnect-on-posture and --no-reconnect-on-posture options
+    preferences->reconnectOnPosture = parser.getToggleOptionValue("reconnect-on-posture", preferences->reconnectOnPosture);
+
     // Resolve --video-codec option
     if (parser.isSet("video-codec")) {
         preferences->videoCodecConfig = mapValue(m_VideoCodecMap, parser.getChoiceOptionValue("video-codec"));
diff --git a/app/cli/commandlineparser.h b/app/cli/commandlineparser.h
index 60531bee..5962b719 100644
--- a/app/cli/commandlineparser.h
+++ b/app/cli/commandlineparser.h
@@ -72,6 +72,7 @@ private:
     QMap<QString, StreamingPreferences::VideoCodecConfig> m_VideoCodecMap;
     QMap<QString, StreamingPreferences::VideoDecoderSelection> m_VideoDecoderMap;
     QMap<QString, StreamingPreferences::CaptureSysKeysMode> m_CaptureSysKeysModeMap;
+    QMap<QString, StreamingPreferences::PostureMode> m_PostureModeMap;
     QMap<QString, StreamingPreferences::SteamControllerGrips> m_SteamControllerGripsMap;
 };
 
diff --git a/app/gui/SettingsView.qml b/app/gui/SettingsView.qml
index cf31489e..0eff40d7 100644
--- a/app/gui/SettingsView.qml
+++ b/app/gui/SettingsView.qml
@@ -2721,6 +2721,49 @@ FocusScope {
                     }
                 }
 
+                ConsoleSettingRow {
+                    width: parent.width
+                    objectName: "clientPostureRow"
+                    labelItem: ConsoleText { text: qsTr("Touch tablet posture") }
+                    description: qsTr("Tell the host this client is a touch tablet so it can adapt its virtual display, for example to dock the on-screen keyboard. Auto detects tablet mode and touch hardware. Only hosts that support it react to this.")
+                    editor: AutoResizingComboBox {
+                        id: clientPostureMode
+                        textRole: "text"
+                        model: ListModel {
+                            ListElement { text: qsTr("Auto"); val: StreamingPreferences.POSTURE_AUTO }
+                            ListElement { text: qsTr("Always tablet"); val: StreamingPreferences.POSTURE_ALWAYS_TABLET }
+                            ListElement { text: qsTr("Always handheld (gamepad)"); val: StreamingPreferences.POSTURE_ALWAYS_HANDHELD }
+                            ListElement { text: qsTr("Always desktop (keyboard)"); val: StreamingPreferences.POSTURE_ALWAYS_DESKTOP }
+                            ListElement { text: qsTr("Never"); val: StreamingPreferences.POSTURE_NEVER }
+                        }
+                        Component.onCompleted: {
+                            for (var i = 0; i < count; ++i) {
+                                if (model.get(i).val === StreamingPreferences.clientPostureMode) { currentIndex = i; break }
+                            }
+                            recalculateWidth()
+                        }
+                        onActivated: StreamingPreferences.clientPostureMode = model.get(currentIndex).val
+                    }
+                }
+
+                ConsoleCheckBox {
+                    id: reconnectOnPostureCheck
+                    objectName: "reconnectOnPostureCheck"
+                    hoverEnabled: true
+                    width: parent.width
+                    text: qsTr("Reconnect when posture changes")
+                    font.pixelSize: Style.typeSize("body", settingsShell.Window.window)
+                    checked: StreamingPreferences.reconnectOnPosture
+                    onCheckedChanged: {
+                        StreamingPreferences.reconnectOnPosture = checked
+                    }
+
+                    ToolTip.delay: 1000
+                    ToolTip.timeout: 5000
+                    ToolTip.visible: hovered
+                    ToolTip.text: qsTr("When the tablet mode changes during a stream, briefly resume the stream so the host can adapt its virtual display, for example to dock the on-screen keyboard. At most once a minute.")
+                }
+
                 ConsoleCheckBox {
                     id: absoluteTouchCheck
                     hoverEnabled: true
diff --git a/app/settings/streamingpreferences.cpp b/app/settings/streamingpreferences.cpp
index 0ced2a66..a79bbc67 100644
--- a/app/settings/streamingpreferences.cpp
+++ b/app/settings/streamingpreferences.cpp
@@ -70,6 +70,8 @@
 #define SER_REVERSESCROLL "reversescroll"
 #define SER_SWAPFACEBUTTONS "swapfacebuttons"
 #define SER_CAPTURESYSKEYS "capturesyskeys"
+#define SER_CLIENTPOSTURE "clientposture"
+#define SER_RECONNECTONPOSTURE "reconnectonposture"
 #define SER_STEAMCONTROLLERDRIVER "steamcontrollerdriver"
 #define SER_STEAMCONTROLLERMOTION "steamcontrollermotion"
 #define SER_STEAMCONTROLLERSPLITPADS "steamcontrollersplitpads"
@@ -251,6 +253,12 @@ void StreamingPreferences::reload()
     enableHdr = settings.value(SER_HDR, false).toBool();
     captureSysKeysMode = static_cast<CaptureSysKeysMode>(settings.value(SER_CAPTURESYSKEYS,
                                                          static_cast<int>(CaptureSysKeysMode::CSK_OFF)).toInt());
+    clientPostureMode = static_cast<PostureMode>(settings.value(SER_CLIENTPOSTURE,
+                                                 static_cast<int>(PostureMode::POSTURE_AUTO)).toInt());
+    if (clientPostureMode < POSTURE_AUTO || clientPostureMode > POSTURE_ALWAYS_DESKTOP) {
+        clientPostureMode = POSTURE_AUTO;
+    }
+    reconnectOnPosture = settings.value(SER_RECONNECTONPOSTURE, true).toBool();
     steamControllerDriver = settings.value(SER_STEAMCONTROLLERDRIVER, true).toBool();
     steamControllerMotion = settings.value(SER_STEAMCONTROLLERMOTION, true).toBool();
     steamControllerSplitPads = settings.value(SER_STEAMCONTROLLERSPLITPADS, true).toBool();
@@ -498,6 +506,8 @@ void StreamingPreferences::save()
     settings.setValue(SER_REVERSESCROLL, reverseScrollDirection);
     settings.setValue(SER_SWAPFACEBUTTONS, swapFaceButtons);
     settings.setValue(SER_CAPTURESYSKEYS, captureSysKeysMode);
+    settings.setValue(SER_CLIENTPOSTURE, clientPostureMode);
+    settings.setValue(SER_RECONNECTONPOSTURE, reconnectOnPosture);
     settings.setValue(SER_KEEPAWAKE, keepAwake);
     settings.setValue(SER_STEAMCONTROLLERDRIVER, steamControllerDriver);
     settings.setValue(SER_STEAMCONTROLLERMOTION, steamControllerMotion);
diff --git a/app/settings/streamingpreferences.h b/app/settings/streamingpreferences.h
index 75768d13..b4127ae5 100644
--- a/app/settings/streamingpreferences.h
+++ b/app/settings/streamingpreferences.h
@@ -152,6 +152,20 @@ public:
     };
     Q_ENUM(CaptureSysKeysMode);
 
+    // Whether to tell the host this is a touch-primary client (tablet posture).
+    // Auto detects from OS tablet mode and input devices; the explicit choices
+    // override detection.
+    enum PostureMode
+    {
+        POSTURE_AUTO,
+        POSTURE_ALWAYS_TABLET,
+        POSTURE_NEVER,
+        // Appended so stored values keep their meaning
+        POSTURE_ALWAYS_HANDHELD,
+        POSTURE_ALWAYS_DESKTOP,
+    };
+    Q_ENUM(PostureMode);
+
     // What the Steam Controller (2026)'s four grip buttons become on the host
     enum SteamControllerGrips
     {
@@ -221,6 +235,8 @@ public:
     Q_PROPERTY(bool swapFaceButtons MEMBER swapFaceButtons NOTIFY swapFaceButtonsChanged)
     Q_PROPERTY(bool keepAwake MEMBER keepAwake NOTIFY keepAwakeChanged)
     Q_PROPERTY(CaptureSysKeysMode captureSysKeysMode MEMBER captureSysKeysMode NOTIFY captureSysKeysModeChanged)
+    Q_PROPERTY(PostureMode clientPostureMode MEMBER clientPostureMode NOTIFY clientPostureModeChanged)
+    Q_PROPERTY(bool reconnectOnPosture MEMBER reconnectOnPosture NOTIFY reconnectOnPostureChanged)
     Q_PROPERTY(bool steamControllerDriver MEMBER steamControllerDriver NOTIFY steamControllerChanged)
     Q_PROPERTY(bool steamControllerMotion MEMBER steamControllerMotion NOTIFY steamControllerChanged)
     Q_PROPERTY(bool steamControllerSplitPads MEMBER steamControllerSplitPads NOTIFY steamControllerChanged)
@@ -297,6 +313,11 @@ public:
     bool uiControllerFullscreen = true;
     Language language;
     CaptureSysKeysMode captureSysKeysMode;
+    PostureMode clientPostureMode = POSTURE_AUTO;
+    // Resume the stream automatically when a posture change crosses the touch
+    // boundary (see streaming/posturemonitor.h), so the host recreates its
+    // virtual display for the new posture.
+    bool reconnectOnPosture = true;
     RendererSelection rendererSelection;
     // Steam Controller (2026) over USB cable / wireless puck (app/streaming/input/steamcontroller)
     bool steamControllerDriver;
@@ -360,6 +381,8 @@ signals:
     void reverseScrollDirectionChanged();
     void swapFaceButtonsChanged();
     void captureSysKeysModeChanged();
+    void clientPostureModeChanged();
+    void reconnectOnPostureChanged();
     void steamControllerChanged();
     void keepAwakeChanged();
     void languageChanged();
