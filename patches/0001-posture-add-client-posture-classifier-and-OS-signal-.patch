diff --git a/app/backend/postureclassifier.cpp b/app/backend/postureclassifier.cpp
new file mode 100644
index 00000000..1863d9df
--- /dev/null
+++ b/app/backend/postureclassifier.cpp
@@ -0,0 +1,251 @@
+#include "postureclassifier.h"
+
+#include <cstring>
+
+namespace posture {
+
+const char* className(PostureClass cls)
+{
+    switch (cls) {
+    case PostureClass::Desktop:  return "desktop";
+    case PostureClass::Laptop:   return "laptop";
+    case PostureClass::Tablet:   return "tablet";
+    case PostureClass::Handheld: return "handheld";
+    case PostureClass::Phone:    return "phone";
+    }
+    return "desktop";
+}
+
+bool parseClassName(const std::string& name, PostureClass& out)
+{
+    static const PostureClass all[] = {
+        PostureClass::Desktop, PostureClass::Laptop, PostureClass::Tablet,
+        PostureClass::Handheld, PostureClass::Phone,
+    };
+    for (PostureClass cls : all) {
+        if (name == className(cls)) {
+            out = cls;
+            return true;
+        }
+    }
+    return false;
+}
+
+Result classify(const Signals& s)
+{
+    Result r;
+    r.touch = s.hasTouchscreen;
+
+    const bool tabletSignal = s.osTabletMode.has_value();
+    // KWin can report tabletModeAvailable=false even on a detachable 2-in-1
+    // whose tabletMode property follows the real state (checked on a Dell
+    // Latitude 5290 2-in-1: tabletMode=true with the keyboard detached).
+    // So tabletMode=true is believed when a touchscreen exists, at lower
+    // confidence if the OS says it cannot report tablet mode. tabletMode=false
+    // with available=false is only 'unknown' and falls back to input devices.
+    const bool conflict = tabletSignal && s.osTabletModeAvailable.has_value() &&
+                          !*s.osTabletModeAvailable;
+    const bool trustedTablet = tabletSignal && (!conflict || *s.osTabletMode);
+
+    if (!s.hasTouchscreen) {
+        // Nothing to touch: never a touch class, whatever the OS says
+        r.cls = (s.portable.value_or(false)) ? PostureClass::Laptop : PostureClass::Desktop;
+        r.confidence = (tabletSignal && *s.osTabletMode) ? Confidence::Low : Confidence::High;
+        return r;
+    }
+
+    if (s.handheldForm) {
+        // A handheld gaming device has no keyboard to fold away; a docked keyboard
+        // cannot be told apart reliably, so that case is left to the user override.
+        r.cls = PostureClass::Handheld;
+        r.confidence = Confidence::High;
+        return r;
+    }
+
+    if (trustedTablet) {
+        if (*s.osTabletMode) {
+            // Tablet posture with a controller in hand is used like a handheld
+            r.cls = s.hasGamepad ? PostureClass::Handheld : PostureClass::Tablet;
+        }
+        else {
+            r.cls = PostureClass::Laptop;
+        }
+        r.confidence = conflict ? Confidence::Medium : Confidence::High;
+        return r;
+    }
+
+    // No usable OS tablet signal: touchscreen presence plus input devices
+    if (!s.hasKeyboard && !s.hasPointer) {
+        r.cls = s.hasGamepad ? PostureClass::Handheld : PostureClass::Tablet;
+        r.confidence = Confidence::Medium;
+    }
+    else {
+        // Keyboard or pointer present: a touchscreen laptop, or a touch monitor
+        r.cls = (s.portable.value_or(true)) ? PostureClass::Laptop : PostureClass::Desktop;
+        // A tablet-mode claim that the devices contradict is worth flagging
+        r.confidence = (conflict && *s.osTabletMode) ? Confidence::Low : Confidence::Medium;
+    }
+    return r;
+}
+
+Result resolve(const Signals& sig, Mode mode)
+{
+    if (mode == Mode::AlwaysTablet) {
+        Result r;
+        r.cls = PostureClass::Tablet;
+        r.confidence = Confidence::High;
+        r.touch = true;
+        return r;
+    }
+    if (mode == Mode::AlwaysHandheld) {
+        Result r;
+        r.cls = PostureClass::Handheld;
+        r.confidence = Confidence::High;
+        r.touch = true;
+        return r;
+    }
+    if (mode == Mode::AlwaysDesktop) {
+        // Desktop mode on the host; touch stays a capability so the host keeps
+        // the touch-sized display.
+        Result r = classify(sig);
+        r.cls = PostureClass::Laptop;
+        r.confidence = Confidence::High;
+        return r;
+    }
+    return classify(sig);
+}
+
+Payload makePayload(const Signals& sig, Mode mode, bool runtimeUpdate)
+{
+    Payload p;
+    if (mode == Mode::Never) {
+        return p;
+    }
+
+    const Result r = resolve(sig, mode);
+    if (!runtimeUpdate && r.cls == PostureClass::Desktop && !r.touch) {
+        return p;
+    }
+
+    p.valid = true;
+    p.cls = r.cls;
+    p.touch = r.touch;
+    return p;
+}
+
+std::string buildQuery(const Payload& p)
+{
+    if (!p.valid) {
+        return std::string();
+    }
+
+    std::string q = "clientPosture=";
+    q += className(p.cls);
+    q += p.touch ? "&clientTouch=1" : "&clientTouch=0";
+    return q;
+}
+
+Payload UpdateGate::normalize(Payload p)
+{
+    // An omitted launch payload means desktop, no touch
+    if (!p.valid) {
+        p.valid = true;
+        p.cls = PostureClass::Desktop;
+        p.touch = false;
+    }
+    return p;
+}
+
+bool UpdateGate::differs(const Payload& a, const Payload& b)
+{
+    // The host mode decides: tablet <-> handheld (a controller attached or
+    // removed) matters although both are touch-primary.
+    return hostMode(a.cls) != hostMode(b.cls) || a.touch != b.touch;
+}
+
+std::optional<Payload> UpdateGate::observe(const Payload& current, Clock::time_point now)
+{
+    const Payload cur = normalize(current);
+
+    if (!differs(cur, m_Sent)) {
+        // Back at the last sent state (or a change that is not worth sending)
+        m_Candidate.reset();
+        return std::nullopt;
+    }
+
+    if (!m_Candidate || differs(cur, *m_Candidate)) {
+        m_Candidate = cur;
+        m_CandidateSince = now;
+        return std::nullopt;
+    }
+    m_Candidate = cur;  // keep freshest size hints
+
+    if (now - m_CandidateSince < m_Debounce) {
+        return std::nullopt;
+    }
+
+    m_Sent = cur;
+    m_Candidate.reset();
+    return cur;
+}
+
+std::optional<bool> parseDisplayChange(const std::string& xml)
+{
+    static const std::string kAttr = "display_change=\"";
+    const auto rootEnd = xml.find('>', xml.find("<root"));
+    const auto at = xml.find(kAttr);
+    if (at == std::string::npos || rootEnd == std::string::npos || at > rootEnd) {
+        return std::nullopt;
+    }
+    const auto value = at + kAttr.size();
+    if (value + 1 >= xml.size() || xml[value + 1] != '"') {
+        return std::nullopt;
+    }
+    if (xml[value] == '1') {
+        return true;
+    }
+    if (xml[value] == '0') {
+        return false;
+    }
+    return std::nullopt;
+}
+
+RestartGate::RestartGate(bool enabled,
+                         const Payload& displayBaseline,
+                         Clock::time_point sessionStart,
+                         std::optional<Clock::time_point> lastRestart,
+                         std::chrono::milliseconds cooldown,
+                         std::chrono::milliseconds armDelay)
+    : m_Enabled(enabled),
+      m_BaselineTouch(touchPrimary(displayBaseline)),
+      m_LatestTouch(m_BaselineTouch),
+      m_ArmedAt(sessionStart + armDelay),
+      m_LastRestart(lastRestart),
+      m_Cooldown(cooldown)
+{
+}
+
+bool RestartGate::touchPrimary(const Payload& p)
+{
+    // An omitted payload (launch from a plain desktop) means not touch-primary
+    return p.valid && isTouchPrimary(p.cls);
+}
+
+void RestartGate::accepted(const Payload& sent, std::optional<bool> hostDisplayChange)
+{
+    m_LatestTouch = touchPrimary(sent);
+    m_HostDisplayChange = hostDisplayChange;
+}
+
+bool RestartGate::due(Clock::time_point now) const
+{
+    // The host knows whether its display still fits; trust it when it says so.
+    const bool displayChange = m_HostDisplayChange ? *m_HostDisplayChange
+                                                   : m_LatestTouch != m_BaselineTouch;
+    if (!m_Enabled || !displayChange || now < m_ArmedAt) {
+        return false;
+    }
+    return !m_LastRestart || now - *m_LastRestart >= m_Cooldown;
+}
+
+} // namespace posture
diff --git a/app/backend/postureclassifier.h b/app/backend/postureclassifier.h
new file mode 100644
index 00000000..322337eb
--- /dev/null
+++ b/app/backend/postureclassifier.h
@@ -0,0 +1,209 @@
+#pragma once
+
+// Client posture classification for the stream-posture-sync feature.
+//
+// Pure logic, no Qt: maps locally observable signals to one of five classes
+// (desktop, laptop, tablet, handheld, phone) plus a confidence, decides what
+// goes on the wire and when a runtime change is worth reporting. Detection of
+// the signals lives in posturedetector.*; this file never touches the OS.
+//
+// Wire contract v2 (all optional, ignored by stock hosts):
+//   clientPosture=desktop|laptop|tablet|handheld|phone
+//   clientTouch=0|1
+// The class never depends on the screen size, DPI or aspect: only the device
+// type and keyboard state matter. Touch-primary means "docked touch keyboard
+// wanted". This client sends tablet for every touch-primary state; handheld and
+// phone exist for other clients and are only parsed here.
+
+#include <chrono>
+#include <optional>
+#include <string>
+
+namespace posture {
+
+enum class PostureClass {
+    Desktop,
+    Laptop,
+    Tablet,
+    Handheld,
+    Phone,
+};
+
+enum class Confidence {
+    Low,
+    Medium,
+    High,
+};
+
+// User choice (mirrors StreamingPreferences::PostureMode)
+enum class Mode {
+    Auto,
+    AlwaysTablet,
+    Never,
+    AlwaysHandheld,
+    AlwaysDesktop,
+};
+
+// What the host does with a class; several classes share one mode.
+enum class HostMode {
+    Desktop,
+    Tablet,
+    Handheld,
+};
+
+struct Signals {
+    // OS says the device is in tablet/slate mode (KWin tabletMode, Windows
+    // SM_CONVERTIBLESLATEMODE == 0). Unset when the OS has no such notion.
+    std::optional<bool> osTabletMode;
+    // OS says it can report tablet mode at all (KWin tabletModeAvailable).
+    // KWin on some 2-in-1s reports tabletMode=true with this false; the tablet
+    // signal is then not trustworthy.
+    std::optional<bool> osTabletModeAvailable;
+
+    bool hasTouchscreen = false;
+    bool hasKeyboard = false;
+    bool hasPointer = false;
+
+    // Chassis says portable (laptop, convertible, detachable). Unset = unknown.
+    std::optional<bool> portable;
+
+    // A game controller is present: built in (handheld) or attached.
+    bool hasGamepad = false;
+    // The OS or firmware declares a handheld gaming device (Windows DeviceForm,
+    // DMI product names of known handhelds).
+    bool handheldForm = false;
+};
+
+struct Result {
+    PostureClass cls = PostureClass::Desktop;
+    Confidence confidence = Confidence::Low;
+    bool touch = false;
+};
+
+// What goes on the wire. valid == false means "send nothing".
+struct Payload {
+    bool valid = false;
+    PostureClass cls = PostureClass::Desktop;
+    bool touch = false;
+};
+
+const char* className(PostureClass cls);
+bool parseClassName(const std::string& name, PostureClass& out);
+
+// Tablet, handheld and phone are the classes the host treats as touch-primary
+inline bool isTouchPrimary(PostureClass cls)
+{
+    return cls == PostureClass::Tablet || cls == PostureClass::Handheld || cls == PostureClass::Phone;
+}
+
+// The host mode a class maps to: handheld has its own, tablet and phone share
+// tablet, everything else is desktop.
+inline HostMode hostMode(PostureClass cls)
+{
+    if (cls == PostureClass::Handheld) {
+        return HostMode::Handheld;
+    }
+    return isTouchPrimary(cls) ? HostMode::Tablet : HostMode::Desktop;
+}
+
+// Classify from signals alone (the Auto path).
+Result classify(const Signals& sig);
+
+// Build the payload for a user mode: Never and (on launch) a non-touch desktop
+// yield an invalid payload, i.e. nothing is sent; callers must check
+// Payload::valid. AlwaysTablet overrides detection.
+//
+// For the launch/resume request (runtimeUpdate == false) a non-touch desktop
+// produces no payload. For a runtime update the new state is always explicit,
+// so the host can leave touch posture again.
+Payload makePayload(const Signals& sig, Mode mode, bool runtimeUpdate);
+
+// Result for a given mode (override-aware), used by makePayload and by callers
+// that want the class for logging.
+Result resolve(const Signals& sig, Mode mode);
+
+// Query string without leading '&', e.g.
+// "clientPosture=tablet&clientTouch=1".
+// Empty for an invalid payload.
+std::string buildQuery(const Payload& payload);
+
+// Decides whether a runtime posture change is worth sending: only when the
+// touch-primary boundary is crossed or the touch-ness changes, and only after
+// the new state has been stable for the debounce interval.
+class UpdateGate {
+public:
+    using Clock = std::chrono::steady_clock;
+
+    UpdateGate(const Payload& lastSent, std::chrono::milliseconds debounce)
+        : m_Sent(normalize(lastSent)), m_Debounce(debounce) {}
+
+    // Feed the latest observation. Returns the payload to send, if any.
+    std::optional<Payload> observe(const Payload& current, Clock::time_point now);
+
+private:
+    static Payload normalize(Payload p);
+    static bool differs(const Payload& a, const Payload& b);
+
+    Payload m_Sent;
+    std::chrono::milliseconds m_Debounce;
+    std::optional<Payload> m_Candidate;
+    Clock::time_point m_CandidateSince{};
+};
+
+// Decides when an accepted runtime update should be followed by an automatic
+// resume of the stream. The host only rebuilds its virtual display on a
+// resume, so after /posture succeeded the client reconnects once, when the
+// touch-primary boundary was crossed relative to the posture the running
+// display was created for (the "baseline", i.e. the launch payload of the
+// current session).
+//
+// Safety rules, all pure logic so they can be tested:
+//   - setting off: never
+//   - nothing before the stream has run for armDelay (never while connecting)
+//   - at most one restart per cooldown, across sessions (lastRestart is carried
+//     into the next session's gate)
+//   - a flip that was blocked by the cooldown is not lost: due() turns true when
+//     the cooldown ends, but only if the latest accepted posture still differs
+//     from the baseline, so a flap back to the baseline needs no restart
+//   - never loops: the new session builds its gate from its own launch payload,
+//     so the posture it started in is the baseline and nothing is due
+// Reads display_change="0|1" from the root element of a /posture reply.
+// Empty when the host did not send it (older hosts).
+std::optional<bool> parseDisplayChange(const std::string& xml);
+
+class RestartGate {
+public:
+    using Clock = std::chrono::steady_clock;
+
+    static constexpr std::chrono::milliseconds kDefaultCooldown{60000};
+    static constexpr std::chrono::milliseconds kDefaultArmDelay{5000};
+
+    RestartGate(bool enabled,
+                const Payload& displayBaseline,
+                Clock::time_point sessionStart,
+                std::optional<Clock::time_point> lastRestart = std::nullopt,
+                std::chrono::milliseconds cooldown = kDefaultCooldown,
+                std::chrono::milliseconds armDelay = kDefaultArmDelay);
+
+    // The host accepted this posture update. hostDisplayChange is the host's own
+    // answer (display_change in the /posture reply): true when the display made
+    // at launch no longer fits, false when it still does. Hosts that do not say
+    // leave it empty and the gate falls back to comparing touch-primary states.
+    void accepted(const Payload& sent, std::optional<bool> hostDisplayChange = std::nullopt);
+
+    // True when the session should be resumed now.
+    bool due(Clock::time_point now) const;
+
+private:
+    static bool touchPrimary(const Payload& p);
+
+    bool m_Enabled;
+    bool m_BaselineTouch;
+    bool m_LatestTouch;
+    std::optional<bool> m_HostDisplayChange;
+    Clock::time_point m_ArmedAt;
+    std::optional<Clock::time_point> m_LastRestart;
+    std::chrono::milliseconds m_Cooldown;
+};
+
+} // namespace posture
diff --git a/app/backend/posturedetector.cpp b/app/backend/posturedetector.cpp
new file mode 100644
index 00000000..b8b02283
--- /dev/null
+++ b/app/backend/posturedetector.cpp
@@ -0,0 +1,217 @@
+#include "posturedetector.h"
+
+#include <QtGlobal>
+#include <utility>
+#include <QString>
+
+#if QT_VERSION >= QT_VERSION_CHECK(6, 0, 0)
+#include <QInputDevice>
+#endif
+
+#ifdef Q_OS_LINUX
+#include <QFile>
+#endif
+
+#ifdef HAVE_POSTURE_DBUS
+#include <QDBusConnection>
+#include <QDBusMessage>
+#include <QDBusVariant>
+#endif
+
+#ifdef Q_OS_WIN
+#include <windows.h>
+#endif
+
+#include "SDL_compat.h"
+
+namespace posture {
+
+// The SDL game controller subsystem is reference counted, so a short-lived
+// init here is safe whether or not the stream or the GUI already holds it.
+static bool gameControllerPresent()
+{
+    if (SDL_InitSubSystem(SDL_INIT_GAMECONTROLLER) != 0) {
+        return false;
+    }
+    bool found = false;
+    const int count = SDL_NumJoysticks();
+    for (int i = 0; i < count && !found; i++) {
+        found = SDL_IsGameController(i) == SDL_TRUE;
+    }
+    SDL_QuitSubSystem(SDL_INIT_GAMECONTROLLER);
+    return found;
+}
+
+#ifdef Q_OS_LINUX
+// SMBIOS chassis types: https://www.dmtf.org/standards/smbios (System Enclosure)
+static std::optional<bool> chassisIsPortable()
+{
+    QFile f("/sys/class/dmi/id/chassis_type");
+    if (!f.open(QIODevice::ReadOnly)) {
+        return std::nullopt;
+    }
+    bool ok = false;
+    const int type = QString::fromUtf8(f.readAll()).trimmed().toInt(&ok);
+    if (!ok) {
+        return std::nullopt;
+    }
+    switch (type) {
+    case 8:   // Portable
+    case 9:   // Laptop
+    case 10:  // Notebook
+    case 11:  // Handheld
+    case 14:  // Sub Notebook
+    case 30:  // Tablet
+    case 31:  // Convertible
+    case 32:  // Detachable
+        return true;
+    case 3:   // Desktop
+    case 4:   // Low Profile Desktop
+    case 5:   // Pizza Box
+    case 6:   // Mini Tower
+    case 7:   // Tower
+    case 13:  // All in One
+    case 15:  // Space-saving
+    case 16:  // Lunch Box
+    case 17:  // Main Server Chassis
+    case 23:  // Rack Mount Chassis
+    case 24:  // Sealed-case PC
+    case 34:  // Embedded PC
+    case 35:  // Mini PC
+    case 36:  // Stick PC
+        return false;
+    default:  // Other/Unknown/virtual
+        return std::nullopt;
+    }
+}
+#endif
+
+Signals collectLocalSignals()
+{
+    Signals s;
+
+#if QT_VERSION >= QT_VERSION_CHECK(6, 0, 0)
+    for (const QInputDevice* dev : QInputDevice::devices()) {
+        switch (dev->type()) {
+        case QInputDevice::DeviceType::TouchScreen:
+            s.hasTouchscreen = true;
+            break;
+        case QInputDevice::DeviceType::Keyboard:
+            s.hasKeyboard = true;
+            break;
+        case QInputDevice::DeviceType::Mouse:
+        case QInputDevice::DeviceType::TouchPad:
+            s.hasPointer = true;
+            break;
+        default:
+            break;
+        }
+    }
+#endif
+
+#ifdef Q_OS_LINUX
+    s.portable = chassisIsPortable();
+#endif
+
+#ifdef Q_OS_WIN
+    // Not compiled or run in the Linux development environment; checked by
+    // inspection against the Win32 documentation only.
+    constexpr int kSmDigitizer = 94;          // SM_DIGITIZER
+    constexpr int kNidIntegratedTouch = 0x1;  // NID_INTEGRATED_TOUCH
+    constexpr int kNidReady = 0x80;           // NID_READY
+    const int digitizer = GetSystemMetrics(kSmDigitizer);
+    s.hasTouchscreen = (digitizer & kNidIntegratedTouch) && (digitizer & kNidReady);
+    s.hasPointer = GetSystemMetrics(SM_MOUSEPRESENT) != 0;
+    // Windows has no cheap keyboard-presence query; a detached tablet has no
+    // mouse either, so treat the two together.
+    s.hasKeyboard = s.hasPointer;
+
+    SYSTEM_POWER_STATUS power = {};
+    if (GetSystemPowerStatus(&power)) {
+        // 128 = no system battery
+        s.portable = power.BatteryFlag != 128 && power.BatteryFlag != 255;
+    }
+
+    // DeviceForm is the OEM's declaration of the device type; 0x2E is a
+    // handheld gaming PC.
+    DWORD deviceForm = 0;
+    DWORD deviceFormSize = sizeof(deviceForm);
+    if (RegGetValueW(HKEY_LOCAL_MACHINE,
+                     L"SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\OEM",
+                     L"DeviceForm",
+                     RRF_RT_REG_DWORD,
+                     nullptr,
+                     &deviceForm,
+                     &deviceFormSize) == ERROR_SUCCESS) {
+        s.handheldForm = deviceForm == 0x2E;
+    }
+#endif
+
+    s.hasGamepad = gameControllerPresent();
+
+    return s;
+}
+
+void collectOsTabletSignals(Signals& s)
+{
+#ifdef HAVE_POSTURE_DBUS
+    QDBusConnection bus = QDBusConnection::sessionBus();
+    if (bus.isConnected()) {
+        auto readBool = [&bus](const char* property) -> std::optional<bool> {
+            QDBusMessage call = QDBusMessage::createMethodCall(
+                QStringLiteral("org.kde.KWin"), QStringLiteral("/org/kde/KWin"),
+                QStringLiteral("org.freedesktop.DBus.Properties"), QStringLiteral("Get"));
+            call << QStringLiteral("org.kde.KWin.TabletModeManager") << QString::fromLatin1(property);
+            const QDBusMessage reply = bus.call(call, QDBus::Block, 500);
+            if (reply.type() != QDBusMessage::ReplyMessage || reply.arguments().isEmpty()) {
+                return std::nullopt;
+            }
+            const QVariant value = qvariant_cast<QDBusVariant>(reply.arguments().constFirst()).variant();
+            if (value.userType() != QMetaType::Bool) {
+                return std::nullopt;
+            }
+            return value.toBool();
+        };
+
+        s.osTabletMode = readBool("tabletMode");
+        s.osTabletModeAvailable = readBool("tabletModeAvailable");
+    }
+#endif
+
+#ifdef Q_OS_WIN
+    // SM_CONVERTIBLESLATEMODE (0x2003): 0 = slate, non-zero = laptop. Desktops
+    // and external touch monitors may report 0 as well, so only trust it on a
+    // portable machine with an integrated digitizer.
+    if (s.hasTouchscreen && s.portable.value_or(false)) {
+        constexpr int kSmConvertibleSlateMode = 0x2003;
+        s.osTabletMode = GetSystemMetrics(kSmConvertibleSlateMode) == 0;
+    }
+#endif
+
+    Q_UNUSED(s);
+}
+
+TabletModeWatcher::TabletModeWatcher(std::function<void(bool)> onChange)
+    : m_OnChange(std::move(onChange))
+{
+#ifdef HAVE_POSTURE_DBUS
+    QDBusConnection bus = QDBusConnection::sessionBus();
+    if (bus.isConnected()) {
+        m_Active = bus.connect(QStringLiteral("org.kde.KWin"),
+                               QStringLiteral("/org/kde/KWin"),
+                               QStringLiteral("org.kde.KWin.TabletModeManager"),
+                               QStringLiteral("tabletModeChanged"),
+                               this,
+                               SLOT(onTabletModeChanged(bool)));
+    }
+#endif
+}
+
+void TabletModeWatcher::onTabletModeChanged(bool tabletMode)
+{
+    if (m_OnChange) {
+        m_OnChange(tabletMode);
+    }
+}
+
+} // namespace posture
diff --git a/app/backend/posturedetector.h b/app/backend/posturedetector.h
new file mode 100644
index 00000000..029aaa93
--- /dev/null
+++ b/app/backend/posturedetector.h
@@ -0,0 +1,49 @@
+#pragma once
+
+#include "postureclassifier.h"
+
+#include <QObject>
+
+#include <functional>
+
+// Gathers the local signals that posture::classify() consumes. No monitor
+// model, EDID, size or host data is read; every value comes from the OS or Qt.
+namespace posture {
+
+// Non-blocking: Qt input devices and chassis type. Call from the GUI thread
+// (Qt's device list is not thread safe). Screen size and DPI are never read.
+Signals collectLocalSignals();
+
+// OS tablet/slate-mode state. May block briefly (KWin D-Bus, 500 ms cap), so
+// call it off the GUI/stream thread. Leaves the fields unset when the OS has
+// no such signal or the build lacks the feature.
+//   Linux/KDE: org.kde.KWin /org/kde/KWin org.kde.KWin.TabletModeManager
+//   Windows:   GetSystemMetrics(SM_CONVERTIBLESLATEMODE), 0 == slate
+void collectOsTabletSignals(Signals& out);
+
+// Event-driven tablet-mode source: calls onChange(tabletMode) from the thread
+// that owns this object (which must run a Qt event loop) whenever the OS says
+// tablet mode changed. Linux/KDE subscribes to the KWin TabletModeManager
+// tabletModeChanged D-Bus signal; elsewhere (and in builds without QtDBus) it
+// is inert and the caller's periodic sampling is the only source. Windows has
+// no cheap hook without a window of our own, so it samples
+// SM_CONVERTIBLESLATEMODE once a second instead of reacting to WM_SETTINGCHANGE.
+class TabletModeWatcher : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit TabletModeWatcher(std::function<void(bool)> onChange);
+
+    // True when an event subscription is active.
+    bool active() const { return m_Active; }
+
+private slots:
+    void onTabletModeChanged(bool tabletMode);
+
+private:
+    std::function<void(bool)> m_OnChange;
+    bool m_Active = false;
+};
+
+} // namespace posture
