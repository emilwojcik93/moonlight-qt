@@ -0,0 +1,523 @@
+#include "touchmenu.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace touchmenu {
+
+namespace {
+
+// Share of the output height used by one item, a little above the minimum
+constexpr float ItemHeightFraction = 0.13f;
+
+// Longest label, used to size the font so that every label fits its item
+constexpr int LongestLabelChars = 17; // "Toggle statistics"
+
+}
+
+const char* itemLabel(int item)
+{
+    switch (item) {
+    case ItemDisconnect:  return "Disconnect";
+    case ItemQuitSession: return "Quit session";
+    case ItemToggleStats: return "Toggle statistics";
+    case ItemCloseMenu:   return "Close menu";
+    }
+    return "";
+}
+
+Layout computeLayout(int outputWidth, int outputHeight, Side side)
+{
+    Layout layout;
+    if (outputWidth <= 0 || outputHeight <= 0) {
+        return layout;
+    }
+
+    int pad = std::max(4, (int)std::lround(outputHeight * 0.02));
+    int itemHeight = (int)std::ceil(outputHeight * ItemHeightFraction);
+    int minHeight = (int)std::ceil(outputHeight * MinItemHeightFraction);
+    itemHeight = std::max(itemHeight, minHeight);
+
+    int surfaceWidth = std::min(outputWidth, std::max(outputWidth * 45 / 100, 480));
+    int surfaceHeight = ItemCount * itemHeight + (ItemCount + 1) * pad;
+    if (surfaceHeight > outputHeight) {
+        // Degenerate (tiny) output: shrink to fit, the items may get shorter
+        // than the minimum there.
+        pad = std::max(1, outputHeight / 40);
+        itemHeight = (outputHeight - (ItemCount + 1) * pad) / ItemCount;
+        surfaceHeight = ItemCount * itemHeight + (ItemCount + 1) * pad;
+    }
+    if (itemHeight <= 0 || surfaceWidth <= 2 * pad) {
+        return layout;
+    }
+
+    int itemWidth = surfaceWidth - 2 * pad;
+    int panelX = side == Side::Right ? outputWidth - surfaceWidth : 0;
+    layout.valid = true;
+    layout.panelWidth = surfaceWidth;
+    layout.panelX = panelX;
+    layout.surfaceWidth = side == Side::Right ? outputWidth : surfaceWidth;
+    layout.surfaceHeight = surfaceHeight;
+    layout.originY = outputHeight - surfaceHeight;
+    layout.border = std::max(2, itemHeight / 24);
+    for (int i = 0; i < ItemCount; i++) {
+        layout.items[i].x = panelX + pad;
+        layout.items[i].y = pad + i * (itemHeight + pad);
+        layout.items[i].w = itemWidth;
+        layout.items[i].h = itemHeight;
+    }
+
+    int byHeight = (int)std::lround(itemHeight * 0.40);
+    int byWidth = (int)std::lround(itemWidth / (LongestLabelChars * 0.70));
+    layout.fontPixels = std::max(12, std::min(byHeight, byWidth));
+    return layout;
+}
+
+int handleSize(int outputWidth, int outputHeight)
+{
+    if (outputWidth <= 0 || outputHeight <= 0) {
+        return 0;
+    }
+
+    int size = std::max(HandleMinPixels, (int)std::lround(outputHeight * HandleHeightFraction));
+    return std::min(size, std::min(outputWidth, outputHeight));
+}
+
+Rect handleRect(int outputWidth, int outputHeight)
+{
+    Rect rect;
+    int size = handleSize(outputWidth, outputHeight);
+    rect.x = 0;
+    rect.y = outputHeight - size;
+    rect.w = rect.h = size;
+    return rect;
+}
+
+void TouchMenu::setOutputSize(int width, int height)
+{
+    m_OutputWidth = width;
+    m_OutputHeight = height;
+}
+
+TouchMenu::Finger* TouchMenu::find(int64_t id)
+{
+    for (auto& finger : m_Fingers) {
+        if (finger.id == id) {
+            return &finger;
+        }
+    }
+    return nullptr;
+}
+
+bool TouchMenu::moved(const Finger& finger) const
+{
+    float w = m_OutputWidth > 0 ? (float)m_OutputWidth : 1.0f;
+    float h = m_OutputHeight > 0 ? (float)m_OutputHeight : 1.0f;
+    float dx = (finger.x - finger.startX) * w;
+    float dy = (finger.y - finger.startY) * h;
+    float limit = MoveFraction * std::min(w, h);
+    return std::sqrt(dx * dx + dy * dy) >= limit;
+}
+
+void TouchMenu::ignoreAllFingers()
+{
+    for (auto& finger : m_Fingers) {
+        finger.ignored = true;
+    }
+}
+
+bool TouchMenu::inHandle(float x, float y) const
+{
+    if (m_OutputWidth <= 0 || m_OutputHeight <= 0) {
+        return false;
+    }
+
+    Rect r = handleRect(m_OutputWidth, m_OutputHeight);
+    int px = (int)std::floor(x * m_OutputWidth);
+    int py = (int)std::floor(y * m_OutputHeight);
+    return px >= r.x && px < r.x + r.w && py >= r.y && py < r.y + r.h;
+}
+
+void TouchMenu::setTriggers(bool gestures, bool handle)
+{
+    m_GesturesEnabled = gestures;
+    m_HandleEnabled = handle;
+    if (!gestures) {
+        m_Armed = false;
+        cancelEdge();
+    }
+}
+
+void TouchMenu::noteActivity(uint32_t nowMs)
+{
+    m_RecentActivity = true;
+    m_LastActivityMs = nowMs;
+}
+
+void TouchMenu::openMenu(uint32_t nowMs, Side side)
+{
+    cancelEdge();
+    m_Side = side == Side::Right && !m_RightPanelAllowed ? Side::Left : side;
+    m_Armed = false;
+    m_Open = true;
+    m_RecentActivity = false;
+    m_LastTouchMs = nowMs;
+    m_HaveActive = false;
+    m_PressItem = m_CurrentItem = -1;
+    ignoreAllFingers();
+}
+
+void TouchMenu::closeMenu()
+{
+    cancelEdge();
+    m_Open = false;
+    m_RecentActivity = false;
+    m_Armed = false;
+    m_Cancelled = false; // Remaining fingers are ignored, so they cannot re-arm
+    m_HaveActive = false;
+    m_PressItem = -1;
+    m_CurrentItem = -1;
+    ignoreAllFingers();
+}
+
+int TouchMenu::gestureFingerCount() const
+{
+    int count = 0;
+    for (const auto& finger : m_Fingers) {
+        if (!finger.ignored) {
+            count++;
+        }
+    }
+    return count;
+}
+
+int TouchMenu::hitTest(float x, float y) const
+{
+    Layout layout = computeLayout(m_OutputWidth, m_OutputHeight, m_Side);
+    if (!layout.valid) {
+        return -1;
+    }
+
+    int px = (int)std::floor(x * m_OutputWidth);
+    int py = (int)std::floor(y * m_OutputHeight);
+    int localX = px;
+    int localY = py - (m_OutputHeight - layout.surfaceHeight);
+    for (int i = 0; i < ItemCount; i++) {
+        const Rect& r = layout.items[i];
+        if (localX >= r.x && localX < r.x + r.w && localY >= r.y && localY < r.y + r.h) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+int TouchMenu::highlightedItem() const
+{
+    if (m_Open && m_HaveActive && m_PressItem >= 0 && m_CurrentItem == m_PressItem) {
+        return m_PressItem;
+    }
+    return -1;
+}
+
+// Checks the running edge swipe attempt. Returns true when it completes.
+bool TouchMenu::evaluateEdge(uint32_t nowMs)
+{
+    if (!m_EdgeActive) {
+        return false;
+    }
+
+    if ((uint32_t)(nowMs - m_EdgeFirstMs) > EdgeSwipeWindowMs) {
+        cancelEdge();
+        return false;
+    }
+
+    const Finger* a = nullptr;
+    const Finger* b = nullptr;
+    for (const auto& f : m_Fingers) {
+        if (f.id == m_EdgeA) a = &f;
+        if (m_EdgeHaveB && f.id == m_EdgeB) b = &f;
+    }
+    if (a == nullptr || (m_EdgeHaveB && b == nullptr)) {
+        cancelEdge();
+        return false;
+    }
+
+    float w = m_OutputWidth > 0 ? (float)m_OutputWidth : 1.0f;
+    float h = m_OutputHeight > 0 ? (float)m_OutputHeight : 1.0f;
+    float rightLimit = MoveFraction * std::min(w, h) / w; // Normalized x
+    const Finger* swipers[2] = { a, b };
+    bool complete = m_EdgeHaveB;
+    for (const Finger* f : swipers) {
+        if (f == nullptr) {
+            continue;
+        }
+        if (f->x - f->startX > rightLimit) {
+            cancelEdge();
+            return false;
+        }
+        if (f->startX - f->x < EdgeSwipeFraction) {
+            complete = false;
+        }
+    }
+    return complete;
+}
+
+Event TouchMenu::fingerDown(int64_t id, float x, float y, uint32_t nowMs)
+{
+    Event result;
+
+    // A repeated down for a known id replaces the old record (the platform
+    // lost the old contact)
+    if (edgeFinger(id)) {
+        cancelEdge();
+    }
+    m_Fingers.erase(std::remove_if(m_Fingers.begin(), m_Fingers.end(),
+                                   [id](const Finger& f) { return f.id == id; }),
+                    m_Fingers.end());
+    if (m_HaveActive && m_ActiveId == id) {
+        m_HaveActive = false;
+    }
+
+    // Decided before this touch makes the handle visible
+    bool onHandle = !m_Open && m_HandleEnabled && m_RecentActivity && inHandle(x, y);
+
+    Finger finger = { id, x, y, x, y, m_Open || onHandle, onHandle };
+    m_Fingers.push_back(finger);
+
+    if (m_Open) {
+        m_LastTouchMs = nowMs;
+        if (!m_HaveActive) {
+            m_HaveActive = true;
+            m_ActiveId = id;
+            m_PressItem = m_CurrentItem = hitTest(x, y);
+        }
+        result.swallow = true;
+        return result;
+    }
+
+    noteActivity(nowMs);
+    result.swallow = onHandle;
+
+    // Edge swipe: first finger in the zone starts an attempt, a second one
+    // within the pair time joins it, anything else ends it.
+    bool inEdgeZone = x >= 1.0f - EdgeZoneFraction;
+    int gestureFingers = gestureFingerCount();
+    if (m_EdgeActive) {
+        if (!m_EdgeHaveB && gestureFingers == 2 && inEdgeZone && !onHandle &&
+                (uint32_t)(nowMs - m_EdgeFirstMs) <= EdgePairMs) {
+            m_EdgeHaveB = true;
+            m_EdgeB = id;
+        }
+        else {
+            cancelEdge();
+        }
+    }
+    else if (m_GesturesEnabled && gestureFingers == 1 && inEdgeZone && !onHandle) {
+        m_EdgeActive = true;
+        m_EdgeHaveB = false;
+        m_EdgeA = id;
+        m_EdgeFirstMs = nowMs;
+    }
+
+    if (m_GesturesEnabled && !m_Armed && !m_Cancelled && gestureFingerCount() >= HoldFingers) {
+        // Fingers that already travelled too far (a scroll in progress)
+        // do not start a hold.
+        bool anyMoved = false;
+        for (const auto& f : m_Fingers) {
+            if (!f.ignored && moved(f)) {
+                anyMoved = true;
+            }
+        }
+        if (anyMoved) {
+            m_Cancelled = true;
+        }
+        else {
+            m_Armed = true;
+            m_ArmedAtMs = nowMs;
+        }
+    }
+    return result;
+}
+
+Event TouchMenu::fingerMove(int64_t id, float x, float y, uint32_t nowMs)
+{
+    Event result;
+    Finger* finger = find(id);
+
+    if (finger != nullptr) {
+        finger->x = x;
+        finger->y = y;
+    }
+
+    if (m_Open) {
+        m_LastTouchMs = nowMs;
+        if (m_HaveActive && m_ActiveId == id) {
+            m_CurrentItem = hitTest(x, y);
+        }
+        result.swallow = true;
+        return result;
+    }
+
+    noteActivity(nowMs);
+    if (finger == nullptr) {
+        return result;
+    }
+
+    result.swallow = finger->ignored;
+    if (!finger->ignored && m_Armed && moved(*finger)) {
+        m_Armed = false;
+        m_Cancelled = true;
+    }
+
+    if (edgeFinger(id) && evaluateEdge(nowMs)) {
+        openMenu(nowMs, Side::Right);
+        result.type = EventType::Open;
+        result.side = m_Side;
+        result.swallow = true;
+    }
+    return result;
+}
+
+Event TouchMenu::fingerUp(int64_t id, float x, float y, uint32_t nowMs)
+{
+    Event result;
+    Finger* finger = find(id);
+    bool wasIgnored = finger != nullptr ? finger->ignored : false;
+    bool tappedHandle = false;
+
+    if (finger != nullptr) {
+        finger->x = x;
+        finger->y = y;
+        tappedHandle = !m_Open && finger->onHandle && inHandle(x, y) && !moved(*finger);
+        m_Fingers.erase(m_Fingers.begin() + (finger - m_Fingers.data()));
+    }
+
+    if (m_Open) {
+        m_LastTouchMs = nowMs;
+        result.swallow = true;
+        if (m_HaveActive && m_ActiveId == id) {
+            int pressItem = m_PressItem;
+            int upItem = hitTest(x, y);
+            m_HaveActive = false;
+            m_PressItem = m_CurrentItem = -1;
+
+            if (pressItem >= 0 && upItem == pressItem) {
+                if (pressItem == ItemCloseMenu) {
+                    result.type = EventType::Close;
+                }
+                else {
+                    result.type = EventType::Activate;
+                    result.item = pressItem;
+                }
+                closeMenu();
+            }
+            else if (pressItem < 0 && upItem < 0) {
+                result.type = EventType::Close;
+                closeMenu();
+            }
+        }
+        return result;
+    }
+
+    result.swallow = wasIgnored;
+    if (edgeFinger(id)) {
+        cancelEdge();
+    }
+    if (gestureFingerCount() < HoldFingers) {
+        m_Armed = false;
+        m_Cancelled = false;
+    }
+
+    if (tappedHandle) {
+        openMenu(nowMs, Side::Left);
+        result.type = EventType::Open;
+        result.side = m_Side;
+        result.swallow = true;
+    }
+    else {
+        noteActivity(nowMs);
+    }
+    return result;
+}
+
+Event TouchMenu::fingerCancel(int64_t id, uint32_t nowMs)
+{
+    Event result;
+    Finger* finger = find(id);
+    bool wasIgnored = finger != nullptr ? finger->ignored : false;
+
+    if (finger != nullptr) {
+        m_Fingers.erase(m_Fingers.begin() + (finger - m_Fingers.data()));
+    }
+
+    if (m_Open) {
+        m_LastTouchMs = nowMs;
+        result.swallow = true;
+        if (m_HaveActive && m_ActiveId == id) {
+            m_HaveActive = false;
+            m_PressItem = m_CurrentItem = -1;
+        }
+        return result;
+    }
+
+    result.swallow = wasIgnored;
+    if (edgeFinger(id)) {
+        cancelEdge();
+    }
+    if (gestureFingerCount() < HoldFingers) {
+        m_Armed = false;
+        m_Cancelled = false;
+    }
+    noteActivity(nowMs);
+    return result;
+}
+
+Event TouchMenu::tick(uint32_t nowMs)
+{
+    Event result;
+
+    if (m_Open) {
+        if ((uint32_t)(nowMs - m_LastTouchMs) >= IdleMs) {
+            closeMenu();
+            result.type = EventType::Close;
+            result.swallow = true;
+        }
+    }
+    else if (m_EdgeActive && (uint32_t)(nowMs - m_EdgeFirstMs) > EdgeSwipeWindowMs) {
+        // Edge swipe timed out. The remaining timers are checked on the next tick.
+        cancelEdge();
+    }
+    else if (m_Armed && (uint32_t)(nowMs - m_ArmedAtMs) >= HoldMs) {
+        openMenu(nowMs, Side::Left);
+        result.type = EventType::Open;
+        result.side = m_Side;
+        result.swallow = true;
+    }
+    else if (m_RecentActivity && (uint32_t)(nowMs - m_LastActivityMs) >= HandleHideMs) {
+        m_RecentActivity = false;
+        // Whatever is still tracked has had no event for a long time: its up
+        // was probably lost. Swallowed fingers stay until they lift.
+        m_Fingers.erase(std::remove_if(m_Fingers.begin(), m_Fingers.end(),
+                                       [](const Finger& f) { return !f.ignored; }),
+                        m_Fingers.end());
+        m_Armed = false;
+        m_Cancelled = false;
+        cancelEdge();
+    }
+    return result;
+}
+
+void TouchMenu::reset()
+{
+    cancelEdge();
+    m_Fingers.clear();
+    m_Open = false;
+    m_RecentActivity = false;
+    m_Armed = false;
+    m_Cancelled = false;
+    m_HaveActive = false;
+    m_PressItem = -1;
+    m_CurrentItem = -1;
+}
+
+}
diff --git a/app/streaming/input/touchmenu.h b/app/streaming/input/touchmenu.h
new file mode 100644
index 00000000..0a9ac1c0
--- /dev/null
+++ b/app/streaming/input/touchmenu.h
@@ -0,0 +1,220 @@
+#pragma once
+
+// Touch-only in-stream menu for the stream-posture-sync feature.
+//
+// Pure logic, no SDL and no Qt GUI: recognizes the "three fingers held still"
+// gesture, tracks the menu while it is open and lays the menu out. Finger
+// positions are normalized 0..1 window coordinates, time is passed in as
+// milliseconds (any monotonic uint32 clock, wrap-around safe). The caller
+// (SdlInputHandler) owns the clock and a periodic tick, sends the events to the
+// host or swallows them, and draws the menu (OverlayManager).
+//
+// Gesture rule: the hold starts when the third finger lands. A fourth finger
+// joining while the hold runs does not restart it. The hold is cancelled when
+// fewer than three fingers are down or when any finger (including a joined
+// one) has moved 3 % of the shorter window side or more from where it landed.
+// Corner handle: the second trigger, for platforms where the compositor keeps
+// a third finger from reaching the client. Any finger event shows a small
+// handle at the bottom-left corner of the output; it hides after HandleHideMs
+// without a finger event. A tap on the visible handle (down and up inside it,
+// moved less than MoveFraction) opens the menu. A touch that starts inside the
+// visible handle never reaches the host, whether or not it ends as a tap. A
+// touch that starts on the corner while the handle is hidden is a normal
+// touch and only makes the handle appear.
+//
+// Lost contacts: a down for an id that is already tracked replaces the old
+// record. When the handle hides after HandleHideMs without any finger event,
+// the remaining tracked fingers are forgotten (the compositor can swallow
+// their up events), so they cannot count towards a later hold.
+//
+// Edge swipe: the trigger that works where the compositor takes three fingers.
+// Two fingers that each land within the rightmost EdgeZoneFraction of the output
+// width, at most EdgePairMs apart, and then both move left by at least
+// EdgeSwipeFraction of the output width within EdgeSwipeWindowMs of the first
+// landing, open the menu on the right side. The attempt is cancelled when
+// either finger lifts, when another finger lands (or the second lands too
+// late), when either finger moves right by more than MoveFraction, or on
+// timeout. Until it opens the touches reach the host; on open the two fingers
+// are swallowed until they lift and activate nothing. The handle tap and the
+// three finger hold open the menu on the left side.
+//
+// After a cancel by movement the gesture cannot re-arm until fewer than three
+// fingers are down again. Fingers that were down when the menu opened, or that
+// landed while it was open, never take part in a later gesture or reach the
+// host: they stay swallowed until they lift.
+
+#include <cstdint>
+#include <vector>
+
+namespace touchmenu {
+
+constexpr uint32_t HoldMs = 800;
+constexpr uint32_t IdleMs = 10000;
+constexpr uint32_t HandleHideMs = 6000;
+constexpr float EdgeZoneFraction = 0.08f;
+constexpr uint32_t EdgePairMs = 300;
+constexpr float EdgeSwipeFraction = 0.10f;
+constexpr uint32_t EdgeSwipeWindowMs = 1200;
+constexpr int HoldFingers = 3;
+constexpr float MoveFraction = 0.03f;
+constexpr float MinItemHeightFraction = 0.12f;
+constexpr float HandleHeightFraction = 0.06f;
+constexpr int HandleMinPixels = 56;
+constexpr int ItemCount = 4;
+
+enum Item {
+    ItemDisconnect = 0,   // End the stream, the host app keeps running
+    ItemQuitSession = 1,  // End the stream and quit the host app
+    ItemToggleStats = 2,
+    ItemCloseMenu = 3,
+};
+
+// Screen side the panel opens on
+enum class Side {
+    Left,
+    Right,
+};
+
+enum class EventType {
+    None,
+    Open,
+    Activate,   // item = any item except ItemCloseMenu, menu is closed
+    Close,      // menu is closed (close item, tap outside, idle timeout)
+};
+
+struct Event {
+    EventType type = EventType::None;
+    int item = -1;
+    Side side = Side::Left; // For Open: the side the panel opens on
+    // True when the touch event that produced this result must not reach the host
+    bool swallow = false;
+};
+
+struct Rect {
+    int x = 0, y = 0, w = 0, h = 0;
+};
+
+// Menu geometry for an output of outputWidth x outputHeight pixels. The surface
+// is anchored at the bottom-left corner of the output: its top-left corner is
+// at (0, outputHeight - surfaceHeight), so surface x equals output x. For the
+// left side the surface is just the panel. For the right side the surface is
+// as wide as the output, transparent except for the panel at its right end.
+// Items are relative to the surface; itemInOutput() gives output pixels.
+struct Layout {
+    bool valid = false;
+    int surfaceWidth = 0, surfaceHeight = 0;
+    int panelX = 0, panelWidth = 0;  // Panel inside the surface, full surface height
+    int originY = 0;                 // Output y of the surface's top edge
+    int border = 1;     // item and frame border thickness
+    int fontPixels = 12;
+    Rect items[ItemCount];
+
+    Rect itemInOutput(int item) const {
+        Rect r = items[item];
+        r.y += originY;
+        return r;
+    }
+};
+
+Layout computeLayout(int outputWidth, int outputHeight, Side side = Side::Left);
+
+// Side of the square corner handle in pixels (0 if the output size is unknown)
+int handleSize(int outputWidth, int outputHeight);
+
+// Handle rectangle in output pixels: bottom-left corner of the output
+Rect handleRect(int outputWidth, int outputHeight);
+const char* itemLabel(int item);
+
+class TouchMenu
+{
+public:
+    // Window drawable size in pixels. Set before feeding events.
+    void setOutputSize(int width, int height);
+
+    // Whether the renderer can draw the full-width surface the right side needs.
+    // When false the edge swipe opens the left panel instead. Default true.
+    void setRightPanelAllowed(bool allowed) { m_RightPanelAllowed = allowed; }
+
+    // Which triggers may open the menu. Gestures are the edge swipe and the
+    // three finger hold. With the handle off it is never shown and a touch on
+    // its corner is a normal touch. Default: both on.
+    void setTriggers(bool gestures, bool handle);
+
+    // Side of the open (or last opened) menu
+    Side side() const { return m_Side; }
+
+    Event fingerDown(int64_t id, float x, float y, uint32_t nowMs);
+    Event fingerMove(int64_t id, float x, float y, uint32_t nowMs);
+    Event fingerUp(int64_t id, float x, float y, uint32_t nowMs);
+
+    // The platform cancelled a contact: like an up that activates nothing.
+    // (SDL2 has no such event; kept for SDL3 style cancels.)
+    Event fingerCancel(int64_t id, uint32_t nowMs);
+
+    // Call periodically while needsTick() is true. May return Open or Close.
+    Event tick(uint32_t nowMs);
+
+    // Forget all fingers and close the menu
+    void reset();
+
+    bool isOpen() const { return m_Open; }
+
+    // True while a hold is being timed, the menu is open or the handle is visible
+    bool needsTick() const { return m_Open || m_Armed || m_RecentActivity || m_EdgeActive; }
+
+    // True while the corner handle should be drawn (never while the menu is open)
+    bool handleVisible() const { return m_HandleEnabled && m_RecentActivity && !m_Open; }
+
+    // Item that the active finger went down on and is still over, or -1
+    int highlightedItem() const;
+
+    // Number of fingers that count towards the gesture (not swallowed)
+    int gestureFingerCount() const;
+
+    // Item under a point in normalized coordinates, or -1 (outside every item)
+    int hitTest(float x, float y) const;
+
+private:
+    struct Finger {
+        int64_t id;
+        float startX, startY;
+        float x, y;
+        bool ignored;
+        bool onHandle;
+    };
+
+    Finger* find(int64_t id);
