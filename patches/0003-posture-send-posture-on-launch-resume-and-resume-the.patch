diff --git a/app/streaming/posturemonitor.cpp b/app/streaming/posturemonitor.cpp
new file mode 100644
index 00000000..4d5d000a
--- /dev/null
+++ b/app/streaming/posturemonitor.cpp
@@ -0,0 +1,141 @@
+#include "posturemonitor.h"
+
+#include "backend/nvhttp.h"
+#include "backend/posturedetector.h"
+
+#include <QDebug>
+#include <QTimer>
+
+PostureMonitor::PostureMonitor(posture::Mode mode,
+                               const posture::Payload& launchPayload,
+                               NvAddress address,
+                               uint16_t httpsPort,
+                               QSslCertificate serverCert,
+                               bool useTrueUid,
+                               bool restartEnabled,
+                               std::optional<std::chrono::steady_clock::time_point> lastRestart)
+    : QThread(nullptr),
+      m_Mode(mode),
+      m_LaunchPayload(launchPayload),
+      m_Address(address),
+      m_HttpsPort(httpsPort),
+      m_ServerCert(serverCert),
+      m_UseTrueUid(useTrueUid),
+      m_RestartEnabled(restartEnabled),
+      m_LastRestart(lastRestart),
+      m_Started(std::chrono::steady_clock::now()),
+      m_NextSample(m_Started + kSampleInterval)
+{
+    setObjectName("Posture Monitor");
+    start();
+}
+
+PostureMonitor::~PostureMonitor()
+{
+    m_Stop = true;
+    quit();
+    wait();
+}
+
+void PostureMonitor::tick()
+{
+    const auto now = std::chrono::steady_clock::now();
+    if (now < m_NextSample) {
+        return;
+    }
+    m_NextSample = now + kSampleInterval;
+
+    // Touch devices: GUI thread, non-blocking
+    const posture::Signals sample = posture::collectLocalSignals();
+    QMutexLocker lock(&m_Mutex);
+    m_Sample = sample;
+    m_HasSample = true;
+}
+
+void PostureMonitor::run()
+{
+    NvHTTP http(m_Address, m_HttpsPort, m_ServerCert, m_UseTrueUid);
+    posture::UpdateGate gate(m_LaunchPayload, kDebounce);
+    posture::RestartGate restart(m_RestartEnabled, m_LaunchPayload, m_Started, m_LastRestart);
+
+    posture::Signals local;
+    bool haveLocal = false;
+    std::optional<bool> osTablet;
+    std::optional<bool> osTabletAvailable;
+    bool busy = false;
+
+    // Pure decision step: no I/O except the /posture call itself. Safe to run
+    // as often as we like; the gates hold the debounce and restart rules.
+    auto evaluate = [&]() {
+        // updatePosture() runs a nested event loop; do not re-enter from it
+        if (busy || !haveLocal) {
+            return;
+        }
+        busy = true;
+
+        posture::Signals sample = local;
+        sample.osTabletMode = osTablet;
+        sample.osTabletModeAvailable = osTabletAvailable;
+        const posture::Payload current = posture::makePayload(sample, m_Mode, true);
+        const auto now = std::chrono::steady_clock::now();
+        if (const auto update = gate.observe(current, now)) {
+            const QString query = QString::fromStdString(posture::buildQuery(*update));
+            qInfo().noquote() << "Client posture changed, notifying host:" << query;
+            try {
+                const std::optional<bool> displayChange = http.updatePosture(query);
+                restart.accepted(*update, displayChange);
+                if (displayChange && !*displayChange) {
+                    qInfo() << "Host switched mode without a new display; no stream restart needed";
+                }
+            } catch (const std::exception& e) {
+                qDebug() << "Posture update ignored:" << e.what();
+            } catch (...) {
+                qDebug() << "Posture update ignored";
+            }
+        }
+
+        if (!m_RestartDue.load() && restart.due(std::chrono::steady_clock::now())) {
+            qInfo() << "Posture change needs a new host display; stream restart requested";
+            m_RestartDue = true;
+        }
+        busy = false;
+    };
+
+    // Event source: KWin tabletModeChanged. Marshalled onto this thread's loop.
+    posture::TabletModeWatcher watcher([&](bool tabletMode) {
+        osTablet = tabletMode;
+        evaluate();
+    });
+    qDebug() << "Posture tablet-mode events:" << (watcher.active() ? "subscribed" : "not available, sampling only");
+
+    // Sampling source and debounce clock
+    QTimer timer;
+    timer.setInterval(250);
+    QObject::connect(&timer, &QTimer::timeout, &timer, [&]() {
+        if (m_Stop) {
+            quit();
+            return;
+        }
+
+        bool fresh = false;
+        {
+            QMutexLocker lock(&m_Mutex);
+            if (m_HasSample) {
+                local = m_Sample;
+                m_HasSample = false;
+                haveLocal = fresh = true;
+            }
+        }
+        if (fresh) {
+            // Blocking D-Bus read (or Win32 metric), at most once a second
+            posture::Signals probe = local;
+            posture::collectOsTabletSignals(probe);
+            osTablet = probe.osTabletMode;
+            osTabletAvailable = probe.osTabletModeAvailable;
+        }
+        evaluate();
+    });
+    timer.start();
+
+    exec();
+}
diff --git a/app/streaming/posturemonitor.h b/app/streaming/posturemonitor.h
new file mode 100644
index 00000000..ab805d1a
--- /dev/null
+++ b/app/streaming/posturemonitor.h
@@ -0,0 +1,77 @@
+#pragma once
+
+#include <QMutex>
+#include <QSslCertificate>
+#include <QThread>
+
+#include <atomic>
+#include <chrono>
+#include <optional>
+
+#include "backend/nvaddress.h"
+#include "backend/postureclassifier.h"
+
+// Watches the client posture while a stream runs, tells the host when it
+// changes (2-in-1 flipped to tablet, keyboard detached, ...) and says when the
+// stream should be resumed so the host rebuilds its virtual display.
+//
+// The Qt event loop of the GUI thread is not pumped during a stream and the SDL
+// loop must never block, so the work lives on a worker thread with its own
+// event loop. Two sources feed it:
+//   - tabletModeChanged D-Bus events (Linux/KDE), handled immediately;
+//   - tick(), called from the SDL loop, which takes a cheap non-blocking sample
+//     of the local signals once a second. The worker adds the OS tablet-mode
+//     state (a D-Bus call that can block) on each sample. This is the fallback
+//     and the only source on Windows.
+// Changes are debounced for a short time, sent as /posture (failures are
+// ignored), and an accepted boundary crossing then makes restartDue() true.
+class PostureMonitor : public QThread
+{
+public:
+    static constexpr std::chrono::milliseconds kSampleInterval{1000};
+    static constexpr std::chrono::milliseconds kDebounce{1000};
+
+    // launchPayload is what the launch/resume request carried (possibly
+    // invalid, meaning nothing was sent), the baseline for change detection and
+    // for the restart decision. restartEnabled is the user setting and
+    // lastRestart the time of the previous automatic restart, if any.
+    PostureMonitor(posture::Mode mode,
+                   const posture::Payload& launchPayload,
+                   NvAddress address,
+                   uint16_t httpsPort,
+                   QSslCertificate serverCert,
+                   bool useTrueUid,
+                   bool restartEnabled,
+                   std::optional<std::chrono::steady_clock::time_point> lastRestart);
+    ~PostureMonitor() override;
+
+    // SDL loop thread only. Cheap; never blocks on I/O.
+    void tick();
+
+    // Any thread. True once the host accepted a posture change that needs a
+    // new virtual display and the restart rules (cooldown, ...) allow it.
+    bool restartDue() const { return m_RestartDue.load(); }
+
+protected:
+    void run() override;
+
+private:
+    posture::Mode m_Mode;
+    posture::Payload m_LaunchPayload;
+    NvAddress m_Address;
+    uint16_t m_HttpsPort;
+    QSslCertificate m_ServerCert;
+    bool m_UseTrueUid;
+    bool m_RestartEnabled;
+    std::optional<std::chrono::steady_clock::time_point> m_LastRestart;
+    std::chrono::steady_clock::time_point m_Started;
+
+    std::chrono::steady_clock::time_point m_NextSample;
+
+    std::atomic<bool> m_Stop{false};
+    std::atomic<bool> m_RestartDue{false};
+
+    QMutex m_Mutex;
+    bool m_HasSample = false;
+    posture::Signals m_Sample;
+};
